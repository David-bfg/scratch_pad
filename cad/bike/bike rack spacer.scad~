$fn=50;

fudge = .3;
// ctl + f for word Front and uncomment lines to render the front STL

// Parameters
hatches = 4;              // Number of cylinders in each direction
//hatches = 2;            // Front number of cylinders
N = hatches;
diameter = 1.5 + fudge;   // Cylinder diameter (mm)
gap = 12.85 + 1.5;        // Center-to-center spacing (mm)
rack_diam = 10.25 + fudge;// diameter of tubes on bike rack
rack_angle = 1.383;       // angle of bike rack taper
length = N * gap;         // size spacer
grid_adjustment = 6.225;  // shift for placement on grid
//grid_adjustment = 9.35; // Front adjustment

difference(){
    // support structure
    hull() {
        translate ([fudge,fudge,0]) cube([length-fudge*2,length-fudge*2,diameter*3]);
        h = diameter*3+2.5+ rack_diam*2/3;

        translate ([length/2-rack_diam/2,length/2-rack_diam/2,0]) cube([rack_diam,rack_diam,h]);
    }

    //contact spaces
    union(){
        // One layer of cylinders along X
        for (y = [grid_adjustment : gap : length]) {
            hull() {
                translate([0, y, -diameter])
                    rotate([0, 90, 0])
                        cylinder(d=diameter, h=length);
                translate([0, y, diameter*3/2])
                    rotate([0, 90, 0])
                        cylinder(d=diameter, h=length);
            }
        }

        // Crossing layer of cylinders along Y
        for (x = [gap/2 : gap : length]) {
            hull() {
                translate([x, 0, -diameter])
                    rotate([-90, 0, 0])
                        cylinder(d=diameter, h=length);
                translate([x, 0, diameter/2])
                    rotate([-90, 0, 0])
                        cylinder(d=diameter, h=length);
            }
        }
        translate([length/2, length/2, (rack_diam/2+diameter*2+3)])
            rotate([rack_angle, 90, 0])
                translate([0, 0, -length])
                    cylinder(d=rack_diam, h=length*2);
        difference() {
            translate ([length/2,length/2,0])
                cube([rack_diam/4*2.6,length*2,length], center = true);

//            translate([0, gap/4, 0]) // Front version
            translate([length/2, length/2, gap/2])
                rotate([0, 90, 0])
                    translate([0, 0, -length])
                        cylinder(d=gap*2, h=length*2);
        }
    }
}
